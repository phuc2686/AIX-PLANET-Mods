{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "api_version": {
      "description": "Lua API contract version targeted by the mod. Currently \"1\".",
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "id": {
      "description": "Unique mod id: lowercase alphanumeric and underscores.",
      "pattern": "^[a-z0-9_]+$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "description": "Semantic version, e.g. 1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "api_version"
  ],
  "title": "AIX PLANET Lua mod manifest",
  "type": "object"
}